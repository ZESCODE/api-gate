{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api$",
      "dest": "https://gate-api.zes.codes/api"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "https://gate-api.zes.codes/api/$1"
    },
    {
      "src": "^/v1$",
      "dest": "https://gate-api.zes.codes/v1"
    },
    {
      "src": "^/v1/(.*)$",
      "dest": "https://gate-api.zes.codes/v1/$1"
    },
    {
      "src": "^/i/(.*)$",
      "dest": "https://gate-api.zes.codes/i/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/"
    }
  ]
}